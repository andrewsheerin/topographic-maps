{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
	"allow": [
      "Bash(git push origin main)",
      "PowerShell(git push origin main)",
      "Bash(git -C project-management push*)",
      "PowerShell(git -C project-management push*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --mirror*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(gh pr merge*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --mirror*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(terraform apply*)",
      "PowerShell(terraform destroy*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/*.tfvars)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(docker:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_commands.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_on_write.py\"", "timeout": 30 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"" }
        ]
      }
    ]
  }
}
